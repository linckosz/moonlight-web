# Caddy — HTTPS for the public-facing parts of the DNS stack:
#   - api.{MW_DOMAIN}        reverse proxy to the PowerDNS REST API
#   - {MW_DOMAIN} + www.*    static presentation website (./site)
#
# Rendered at boot by the caddy entrypoint:
#   @MW_DOMAIN@       → parent domain
#   @TLS_LINE@        → empty for automatic Let's Encrypt, or a "tls ..."
#                       directive when the user supplies cert files / ACME email.
#   @SITE_TLS_LINE@   → same, but never the api-only cert: just an ACME email
#                       (or empty) so the apex/www always get their own cert.
#
# rate_limit comes from the caddy-ratelimit plugin (built into this image via
# xcaddy) and throttles API brute-force / abuse per client IP.

{
	order rate_limit before reverse_proxy
}

api.@MW_DOMAIN@ {
	@TLS_LINE@
	rate_limit {
		zone mw_api {
			key {remote_host}
			events 60
			window 1m
		}
	}
	# pdns = the PowerDNS service on the compose network (API on :8081).
	# Compatibility path: direct PowerDNS API. New clients (0.2.0+) use the
	# restricted dnsapi.* gateway below. This block is retired in a later release.
	reverse_proxy pdns:8081
}

# Restricted DNS-registration API (0.2.0+). Fronts the mw-proxy filtering
# gateway, which holds the real PowerDNS key and only lets a client
# create/update/delete its own A record (+ _owner / _acme-challenge TXT).
# Gets its own certificate (never the api-only user cert): @SITE_TLS_LINE@.
dnsapi.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	rate_limit {
		zone mw_dnsapi {
			key {remote_host}
			events 60
			window 1m
		}
	}
	# mw-proxy = the filtering gateway on the compose network (HTTP on :8080).
	reverse_proxy mw-proxy:8080
}

# Update relay (0.3.0+) — the cached mirror of the project's latest GitHub
# release, on the same mw-proxy container (exact path /v1/update, see update.go).
# Instances point their periodic update check here instead of api.github.com, so
# the installed-version census lands in Umami. Every client falls back to GitHub
# when this host is unreachable, so an outage here delays nothing.
updates.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	rate_limit {
		zone mw_updates {
			key {remote_host}
			events 60
			window 1m
		}
	}
	reverse_proxy mw-proxy:8080
}

# Analytics dashboard — self-hosted Umami (privacy-friendly, cookieless).
# Serves both the tracker script (/script.js) and the admin dashboard.
stats.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	encode zstd gzip
	reverse_proxy umami:3000
}

# stream.@MW_DOMAIN@ — deliberately its own vhost, NOT merged into the apex block
# below. Its behaviour today is unchanged: every path 301s to the apex, because
# it is only a vanity alias printed on the marketing site.
#
# It is split out because the rendezvous path /mw/{id} lands on this host. A
# catch-all redirect living in a shared block would swallow that path before any
# handler could see it — a failure that only surfaces the day the feature ships.
# When the rendezvous arrives, wrap both in `handle` blocks — `handle /mw/*` for
# it, then a bare `handle` holding the redir — so everything that is not a
# rendezvous path keeps redirecting to the apex. It will also need its own
# `header` block: splitting this host out of the apex block means the apex CSP
# (notably `connect-src 'self'`) no longer covers it.
#
# It carries no rate_limit yet, and that is deliberate rather than an oversight:
# a 301 to the apex is not worth a budget, and the global `order rate_limit
# before reverse_proxy` would place the limiter AFTER redir in Caddy's standard
# order, so on a redirect-only host it would never run at all. Add it together
# with the rendezvous route — that block ends in a reverse_proxy, where the
# global order puts it in the right place with no `route` gymnastics. Unlike the
# apex, this host does want one: the apex serves a static site whose page loads
# fan out into many asset requests and would trip a per-IP budget for nothing,
# whereas the rendezvous answers on an identifier, and a budget is what bounds
# guessing it.
stream.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	redir https://@MW_DOMAIN@{uri} permanent
}

# Presentation website — apex + www both serve the static ./site folder.
@MW_DOMAIN@, www.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	# Redirect www visitors to the canonical apex.
	@alias host www.@MW_DOMAIN@
	redir @alias https://@MW_DOMAIN@{uri} permanent

	header {
		# The site is framed by nobody: it has a download button and external
		# links, which is all a clickjacking overlay needs to be worth building.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Deliberately WITHOUT includeSubDomains. The per-machine instances live
		# on <id>.@MW_DOMAIN@ and serve a self-signed certificate until their
		# ACME order lands; pinning HSTS for the whole zone from here would turn
		# that window into a hard failure with no way for the owner to click
		# through to their own machine.
		Strict-Transport-Security "max-age=31536000"
		# 'unsafe-inline' is required by the pages themselves (inline <script>
		# blocks and style attributes), so this is not an XSS barrier. What it
		# does buy: script and connect can only reach the self-hosted Umami,
		# the page cannot be framed, and neither <base> nor a form action can be
		# repointed at another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://stats.@MW_DOMAIN@; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://stats.@MW_DOMAIN@; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Don't advertise the server software.
		-Server
	}

	encode zstd gzip
	root * /srv/site
	# Evaluate Go templates in the HTML pages so cache-busting asset URLs can be
	# stamped from each file's real modified time — e.g.
	#   /assets/chrome.js?v={{(fileStat `/assets/chrome.js`).ModTime.Unix}}
	# When a shared asset (chrome.js/.css, pages.css, i18n.js) changes on disk its
	# mtime changes, the query string changes, and browsers fetch the fresh copy —
	# no manual version bump. Scoped to text/html so the plain-text files (robots,
	# llms.txt, the ACME/domain-verification token) are served verbatim.
	templates {
		mime_types text/html
	}
	file_server
}
