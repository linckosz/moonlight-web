# Caddy — HTTPS for the public-facing parts of the DNS stack:
#   - api.{MW_DOMAIN}        reverse proxy to the PowerDNS REST API
#   - {MW_DOMAIN} + www.*    static presentation website (./site)
#   - stream.{MW_DOMAIN}     the entry page + the rendezvous API (stream.caddy)
#   - stream.dev.{MW_DOMAIN} the STAGING copy of the above, proxied to the
#                            dev compose project (docker-compose.dev.yml)
#
# Only the presentation website may be indexed. Every other host imports
# (no_index) below: they are APIs, a dashboard, and addresses that name a
# machine — none of them is a page anyone should find in a search.
#
# Rendered at boot by the caddy entrypoint:
#   @MW_DOMAIN@       → parent domain
#   @TLS_LINE@        → empty for automatic Let's Encrypt, or a "tls ..."
#                       directive when the user supplies cert files / ACME email.
#   @SITE_TLS_LINE@   → same, but never the api-only cert: just an ACME email
#                       (or empty) so the apex/www always get their own cert.
#
# rate_limit comes from the caddy-ratelimit plugin (built into this image via
# xcaddy) and throttles API brute-force / abuse per client IP.

{
	order rate_limit before reverse_proxy
	# No visitor's address in any log of this server. An error line carries its
	# whole request (address, headers, URI) and the rate limiter names the address
	# it refused, so without this a failing /v1/mwsr would keep what the MWSR page
	# says is not kept. The cost: an error line no longer says which request.
	log default {
		format filter {
			wrap console
			fields {
				request delete
				remote_ip delete
				client_ip delete
			}
		}
	}
}

# The body of the stream.* site, shared with the staging Caddy so the two serve
# the same thing. Defined in its own file for that reason alone.
import /etc/caddy/stream.caddy

# For every host that is not the presentation website. Robots that read
# robots.txt are told to stay out, and every response says the same in a header
# for the ones that only read those — including the AI crawlers, named so that a
# policy of "we obey a specific opt-out only" still applies to them.
#
# robots.txt is answered inside a `handle`, not with a bare `respond`: Caddy runs
# every `handle` before `respond`, so on stream.* the entry page's catch-all
# (try_files … /index.html) would answer /robots.txt with the bootstrap page
# first. A `handle` on a path is sorted ahead of stream_site's own.
#
# Be precise about what this buys: the names are not secrets. They are in public
# DNS and, the moment their certificates are issued, in the Certificate
# Transparency logs, so anyone who looks for them will find them. What this does
# is keep them out of the places nobody looks for them — search results and the
# training sets behind the answers people get instead of search results.
(no_index) {
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
	handle /robots.txt {
		respond <<ROBOTS
			User-agent: *
			Disallow: /

			User-agent: GPTBot
			User-agent: OAI-SearchBot
			User-agent: ChatGPT-User
			User-agent: ClaudeBot
			User-agent: Claude-SearchBot
			User-agent: Claude-User
			User-agent: Google-Extended
			User-agent: PerplexityBot
			User-agent: Perplexity-User
			User-agent: CCBot
			User-agent: Bytespider
			User-agent: Applebot-Extended
			User-agent: meta-externalagent
			User-agent: Amazonbot
			Disallow: /
			ROBOTS 200
	}
}

api.@MW_DOMAIN@ {
	@TLS_LINE@
	import no_index
	# Per subscriber: an IPv6 /64 is one (subscriber_key, stream.caddy).
	import subscriber_key
	rate_limit {
		zone mw_api {
			key {mw_subscriber}
			events 60
			window 1m
		}
	}
	# pdns = the PowerDNS service on the compose network (API on :8081).
	# Compatibility path: direct PowerDNS API. New clients (0.2.0+) use the
	# restricted dnsapi.* gateway below. This block is retired in a later release.
	reverse_proxy pdns:8081
}

# Restricted DNS-registration API (0.2.0+). Fronts the mw-proxy filtering
# gateway, which holds the real PowerDNS key and only lets a client
# create/update/delete its own A record (+ _owner / _acme-challenge TXT).
# Gets its own certificate (never the api-only user cert): @SITE_TLS_LINE@.
dnsapi.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	import no_index
	# Per subscriber: an IPv6 /64 is one (subscriber_key, stream.caddy).
	import subscriber_key
	rate_limit {
		zone mw_dnsapi {
			key {mw_subscriber}
			events 60
			window 1m
		}
	}
	# mw-proxy = the filtering gateway on the compose network (HTTP on :8080).
	reverse_proxy mw-proxy:8080
}

# Update relay (0.3.0+) — the cached mirror of the project's latest GitHub
# release, on the same mw-proxy container (exact path /v1/update, see update.go).
# Instances point their periodic update check here instead of api.github.com, so
# the installed-version census lands in Umami. Every client falls back to GitHub
# when this host is unreachable, so an outage here delays nothing.
updates.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	import no_index
	# Per subscriber: an IPv6 /64 is one (subscriber_key, stream.caddy).
	import subscriber_key
	rate_limit {
		zone mw_updates {
			key {mw_subscriber}
			events 60
			window 1m
		}
	}
	reverse_proxy mw-proxy:8080
}

# Linux package repository (APT + DNF), 0.3.0+ — built by release.yml's
# linux-repo job and shipped here by deploy/powerdns/deploy-packages.sh, run
# by hand like deploy-prod.sh. NOT a GitHub Pages deployment: Pages is one
# site per repository and pages.yml already owns it for the bootstrap
# (bootstrap-watch.yml's reference copy) — the package repo raced it there on
# every tag push and usually won, since building three package formats takes
# longer than publishing a few KB of bootstrap. See the 2026-09-14 incident.
packages.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	import no_index
	encode zstd gzip
	root * /srv/packages
	file_server
}

# Session census (0.3.0+) — the shape and length of each stream, in aggregate,
# on the same mw-proxy container (exact path /v1/session, see session.go). It
# lands in its own Umami website (MW_UMAMI_SESSIONS_WEBSITE_ID).
#
# This block needs the `metrics` A record to exist FIRST (pdns/init.sh adds it):
# Caddy orders a certificate for every name it serves, and for a name that does
# not resolve it fails and keeps retrying forever.
#
# Its own hostname rather than a path on updates.* stays the right shape: it
# means the census can be switched off fleet-wide by deleting one record, while
# the update path — which must keep working — is untouched.
metrics.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	import no_index
	# Per subscriber: an IPv6 /64 is one (subscriber_key, stream.caddy).
	import subscriber_key
	rate_limit {
		zone mw_metrics {
			key {mw_subscriber}
			events 60
			window 1m
		}
	}
	reverse_proxy mw-proxy:8080
}

# Analytics dashboard — self-hosted Umami (privacy-friendly, cookieless).
# Serves both the tracker script (/script.js) and the admin dashboard. Not
# indexed: the only page here is a login form.
stats.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	import no_index
	encode zstd gzip
	reverse_proxy umami:3000
}

# stream.@MW_DOMAIN@ — where people stream (0.3.0+).
#
# This is the address an instance is reached at now that there is no
# per-instance sub-domain: https://stream.@MW_DOMAIN@/{id}. The host holds a
# WebSocket open here, the browser asks for it by identifier, and the two
# exchange WebRTC signalling until they have a direct path. No media crosses
# this box — see mw-rendezvous/main.go.
#
# It is a real host, not an alias, and deliberately separate from the apex: the
# apex is the marketing site and stays wherever it is, while this name can be
# repointed at another machine — or several — the day signalling outgrows one
# box. That separation is only worth anything if nothing here depends on being
# co-located with the site, so keep this block self-contained.
#
# It used to 301 everything to the apex, back when it was a vanity name printed
# on the site with nothing behind it. Nothing redirects any more: this host
# serves the entry page and the API, and the address the user sees is the address
# they stay on.
#
# Never indexed: every address here names somebody's machine. The bootstrap page
# carries <meta name="robots" content="noindex"> as well, which also covers its
# GitHub Pages copy, where no header can be set.
#
# The body is in stream.caddy — the routes, the headers, the rate limit — so
# that the staging copy below serves exactly the same thing.
stream.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	import no_index
	import stream_site
}

# stream.dev.@MW_DOMAIN@ — the STAGING rendezvous, where `main` runs.
#
# Same entry page, same API, served by a second, independent pair of containers
# (docker-compose.dev.yml: its own mw-rendezvous with its own claim store and
# secret, its own Caddy rendering stream.caddy from the dev checkout). This
# block only lends them the certificate: it proxies to that Caddy over the
# shared `mw-edge` network and touches nothing else, so it is written once and
# never edited for a change on the dev side — which is exactly what keeps a dev
# rebuild from ever being a reason to rebuild THIS container. Its no_index is
# here, in the fixed block, so it cannot depend on what the dev side serves.
#
# `dev.` is a label of its own so that MW_DOMAIN=dev.@MW_DOMAIN@ on a host moves
# everything the host derives from the domain at once: the line it holds, the
# address it hands out, and STUN — the browser asks stream.dev.…:3478, which is
# this same box, so coturn needs no second name.
#
# When the dev project is down this answers 502, and that is the right answer.
stream.dev.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	import no_index
	reverse_proxy mw-dev-caddy:80
}

# Presentation website — apex + www both serve the static ./site folder. The
# ONE host that is meant to be found: no no_index here.
@MW_DOMAIN@, www.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	# Redirect www visitors to the canonical apex.
	@alias host www.@MW_DOMAIN@
	redir @alias https://@MW_DOMAIN@{uri} permanent

	header {
		# The site is framed by nobody: it has a download button and external
		# links, which is all a clickjacking overlay needs to be worth building.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Deliberately WITHOUT includeSubDomains. The per-machine instances live
		# on <id>.@MW_DOMAIN@ and serve a self-signed certificate until their
		# ACME order lands; pinning HSTS for the whole zone from here would turn
		# that window into a hard failure with no way for the owner to click
		# through to their own machine.
		Strict-Transport-Security "max-age=31536000"
		# 'unsafe-inline' is required by the pages themselves (inline <script>
		# blocks and style attributes), so this is not an XSS barrier. What it
		# does buy: script and connect can only reach the self-hosted Umami,
		# the page cannot be framed, and neither <base> nor a form action can be
		# repointed at another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://stats.@MW_DOMAIN@; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://stats.@MW_DOMAIN@; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Don't advertise the server software.
		-Server
	}

	# The MWSR page's measure log (mw-proxy, see mwsrlog.go): 3 posts per subscriber
	# per 5 minutes, counted in memory only. No `log` directive in this block on
	# purpose: an access log would keep the very addresses that page says are not.
	# Error lines are covered by the filter in the global options above.
	handle /v1/mwsr {
		import subscriber_key
		rate_limit {
			zone mw_mwsr_log {
				key {mw_subscriber}
				events 3
				window 5m
			}
		}
		reverse_proxy mw-proxy:8080
	}

	encode zstd gzip
	root * /srv/site
	# Evaluate Go templates in the HTML pages so cache-busting asset URLs can be
	# stamped from each file's real modified time — e.g.
	#   /assets/chrome.js?v={{(fileStat `/assets/chrome.js`).ModTime.Unix}}
	# When a shared asset (chrome.js/.css, pages.css, i18n.js) changes on disk its
	# mtime changes, the query string changes, and browsers fetch the fresh copy —
	# no manual version bump. Scoped to text/html so the plain-text files (robots,
	# llms.txt, the ACME/domain-verification token) are served verbatim.
	templates {
		mime_types text/html
	}
	file_server
}
