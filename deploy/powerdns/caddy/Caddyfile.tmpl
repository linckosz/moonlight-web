# Caddy — HTTPS for the public-facing parts of the DNS stack:
#   - api.{MW_DOMAIN}        reverse proxy to the PowerDNS REST API
#   - {MW_DOMAIN} + www.*    static presentation website (./site)
#
# Rendered at boot by the caddy entrypoint:
#   @MW_DOMAIN@       → parent domain
#   @TLS_LINE@        → empty for automatic Let's Encrypt, or a "tls ..."
#                       directive when the user supplies cert files / ACME email.
#   @SITE_TLS_LINE@   → same, but never the api-only cert: just an ACME email
#                       (or empty) so the apex/www always get their own cert.
#
# rate_limit comes from the caddy-ratelimit plugin (built into this image via
# xcaddy) and throttles API brute-force / abuse per client IP.

{
	order rate_limit before reverse_proxy
}

api.@MW_DOMAIN@ {
	@TLS_LINE@
	rate_limit {
		zone mw_api {
			key {remote_host}
			events 60
			window 1m
		}
	}
	# pdns = the PowerDNS service on the compose network (API on :8081).
	# Compatibility path: direct PowerDNS API. New clients (0.2.0+) use the
	# restricted dnsapi.* gateway below. This block is retired in a later release.
	reverse_proxy pdns:8081
}

# Restricted DNS-registration API (0.2.0+). Fronts the mw-proxy filtering
# gateway, which holds the real PowerDNS key and only lets a client
# create/update/delete its own A record (+ _owner / _acme-challenge TXT).
# Gets its own certificate (never the api-only user cert): @SITE_TLS_LINE@.
dnsapi.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	rate_limit {
		zone mw_dnsapi {
			key {remote_host}
			events 60
			window 1m
		}
	}
	# mw-proxy = the filtering gateway on the compose network (HTTP on :8080).
	reverse_proxy mw-proxy:8080
}

# Update relay (0.3.0+) — the cached mirror of the project's latest GitHub
# release, on the same mw-proxy container (exact path /v1/update, see update.go).
# Instances point their periodic update check here instead of api.github.com, so
# the installed-version census lands in Umami. Every client falls back to GitHub
# when this host is unreachable, so an outage here delays nothing.
updates.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	rate_limit {
		zone mw_updates {
			key {remote_host}
			events 60
			window 1m
		}
	}
	reverse_proxy mw-proxy:8080
}

# Analytics dashboard — self-hosted Umami (privacy-friendly, cookieless).
# Serves both the tracker script (/script.js) and the admin dashboard.
stats.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	encode zstd gzip
	reverse_proxy umami:3000
}

# stream.@MW_DOMAIN@ — where people stream (0.3.0+).
#
# This is the address an instance is reached at now that there is no
# per-instance sub-domain: https://stream.@MW_DOMAIN@/{id}. The host holds a
# WebSocket open here, the browser asks for it by identifier, and the two
# exchange WebRTC signalling until they have a direct path. No media crosses
# this box — see mw-rendezvous/main.go.
#
# It is a real host, not an alias, and deliberately separate from the apex: the
# apex is the marketing site and stays wherever it is, while this name can be
# repointed at another machine — or several — the day signalling outgrows one
# box. That separation is only worth anything if nothing here depends on being
# co-located with the site, so keep this block self-contained.
#
# It used to 301 everything to the apex, back when it was a vanity name printed
# on the site with nothing behind it. Nothing redirects any more: this host
# serves the entry page and the API, and the address the user sees is the address
# they stay on.
stream.@MW_DOMAIN@ {
	@SITE_TLS_LINE@

	header {
		X-Content-Type-Options "nosniff"
		# The identifier is in the path, so it would otherwise ride along in the
		# Referer of every outbound link and asset.
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Signalling API: /v1/claim, /v1/host and /v1/peer. Matched ahead of the page
	# handler below, and the only reason an identifier can safely be a bare path
	# segment: "v1" is not 26 Crockford characters, so the two can never collide.
	handle /v1/* {
		# The budget that matters is inside mw-rendezvous, which distinguishes a
		# new claim from a host reconnecting and a browser from either. This one
		# is the coarse outer bound on connection attempts — and unlike the
		# redirect-only host this replaces, the block ends in a reverse_proxy, so
		# the global `order rate_limit before reverse_proxy` puts the limiter
		# where it will actually run.
		#
		# It counts connection ATTEMPTS, not traffic: a held line is one request
		# that then stays open for days, so a host is charged once per reconnect.
		rate_limit {
			zone mw_rendezvous {
				key {remote_host}
				events 120
				window 1m
			}
		}
		reverse_proxy mw-rendezvous:8090
	}

	# Everything else is the bootstrap: a few kilobytes of HTML and JavaScript
	# that install a Service Worker, run the MW-BIND-v1 handshake and then fetch
	# the actual interface from the user's own machine over WebRTC.
	#
	# Every path serves the same page — /{id} is read by the page from its own
	# location, so there is nothing per-identifier on disk and no redirect in the
	# way. try_files, not rewrite, so a real asset still wins over the fallback.
	handle {
		header {
			# This one IS a document, so it gets the page-shaped protections the
			# API block has no use for.
			X-Frame-Options "DENY"
			# Kept in step with the <meta> CSP inside index.html, which is what
			# protects the copy published to GitHub Pages (Pages serves no
			# headers of its own). The two are enforced independently and
			# intersect, so a directive relaxed in one place and not the other
			# silently becomes the strictest of the pair — change both together.
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		}
		encode zstd gzip
		root * /srv/bootstrap
		try_files {path} /index.html
		# CNAME only means something to GitHub Pages, which serves the reference
		# copy of these same files. Serving it here would just publish that
		# host's name to anyone who asks.
		file_server {
			hide CNAME
		}
	}
}

# Presentation website — apex + www both serve the static ./site folder.
@MW_DOMAIN@, www.@MW_DOMAIN@ {
	@SITE_TLS_LINE@
	# Redirect www visitors to the canonical apex.
	@alias host www.@MW_DOMAIN@
	redir @alias https://@MW_DOMAIN@{uri} permanent

	header {
		# The site is framed by nobody: it has a download button and external
		# links, which is all a clickjacking overlay needs to be worth building.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Deliberately WITHOUT includeSubDomains. The per-machine instances live
		# on <id>.@MW_DOMAIN@ and serve a self-signed certificate until their
		# ACME order lands; pinning HSTS for the whole zone from here would turn
		# that window into a hard failure with no way for the owner to click
		# through to their own machine.
		Strict-Transport-Security "max-age=31536000"
		# 'unsafe-inline' is required by the pages themselves (inline <script>
		# blocks and style attributes), so this is not an XSS barrier. What it
		# does buy: script and connect can only reach the self-hosted Umami,
		# the page cannot be framed, and neither <base> nor a form action can be
		# repointed at another origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://stats.@MW_DOMAIN@; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://stats.@MW_DOMAIN@; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		# Don't advertise the server software.
		-Server
	}

	encode zstd gzip
	root * /srv/site
	# Evaluate Go templates in the HTML pages so cache-busting asset URLs can be
	# stamped from each file's real modified time — e.g.
	#   /assets/chrome.js?v={{(fileStat `/assets/chrome.js`).ModTime.Unix}}
	# When a shared asset (chrome.js/.css, pages.css, i18n.js) changes on disk its
	# mtime changes, the query string changes, and browsers fetch the fresh copy —
	# no manual version bump. Scoped to text/html so the plain-text files (robots,
	# llms.txt, the ACME/domain-verification token) are served verbatim.
	templates {
		mime_types text/html
	}
	file_server
}
