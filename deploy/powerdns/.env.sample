# MoonlightWeb — self-hosted PowerDNS + Caddy (Docker) configuration.
# Copy to ".env" in this directory, then edit. NEVER commit the real .env.

# Parent domain you own and host on this PowerDNS server.
# Each MoonlightWeb instance gets a random subdomain "{uniqueId}.{MW_DOMAIN}".
MW_DOMAIN=example.top

# Public IPv4 of THIS DNS box. Used for the apex A record, the ns1/ns2 glue
# and the api.{MW_DOMAIN} host. Must match what you register at your registrar.
MW_PUBLIC_IP=203.0.113.10

# PowerDNS REST API key (X-API-Key). SECRET — generate a long random value, e.g.
#   openssl rand -hex 24
# Full-access key. SERVER-SIDE ONLY: it is used by pdns and injected by mw-proxy
# toward pdns. MoonlightWeb instances never receive it — they authenticate to the
# restricted gateway with MW_PDNS_PROXY_KEY (see below).
MW_PDNS_API_KEY=change-me-to-a-long-random-secret

# ── Restricted DNS-registration API (mw-proxy, for MoonlightWeb 0.2.0+) ──────
# The RESTRICTED key MoonlightWeb 0.2.0+ presents to https://dnsapi.{MW_DOMAIN}.
# mw-proxy accepts it but only lets a client create/update/delete its own A
# record (+ _owner / _acme-challenge TXT) on this zone — nothing else. A leak of
# this key cannot delete zones, touch DNSSEC, or reach other zones. SECRET; use
# this value as MW_PDNS_TOKEN in the MoonlightWeb 0.2.0+ server .env.
#   openssl rand -hex 24
MW_PDNS_PROXY_KEY=change-me-to-a-long-random-secret

# HMAC key mw-proxy uses to store per-instance ownership fingerprints. SECRET,
# SERVER-SIDE ONLY (never distributed). A leak of the ownership store is inert
# without it. Generate once and keep stable (rotating it forgets who owns what).
#   openssl rand -hex 32
MW_PDNS_OWNER_SECRET=change-me-to-a-long-random-secret

# Max NEW subdomains a single client IP may claim per hour via mw-proxy
# (0 = unlimited). Bounds bulk record creation. Optional; default 20.
MW_PROXY_MAX_NEW_PER_HOUR=20

# The retirement switch. `off` refuses the creation of any NEW sub-domain while
# leaving every existing one fully working — its A record still follows a
# changing home IP, its certificate still renews, until the February 2027
# shutdown. Anything else (or unset) leaves registration open.
#
# Throw it the day MoonlightWeb 0.3.0 is published, not before: until there is a
# release that reaches machines through the rendezvous, refusing a registration
# would leave someone with no way to stream over the internet at all. A refused
# instance is told so in words, on its own admin page.
MW_SUBDOMAIN_REGISTRATION=on

# ── Rendezvous server (0.3.0+, stream.{MW_DOMAIN}) ───────────────────────────
# HMAC key mw-rendezvous uses to store identifier ownership. SECRET, SERVER-SIDE
# ONLY. Deliberately NOT the same value as MW_PDNS_OWNER_SECRET: that one
# authorises a DNS zone claim and retires with the sub-domain mechanism in
# February 2027, this one authorises a rendezvous line. Generate once and keep
# stable — rotating it forgets which machine owns which identifier, and every
# host would have to claim a new one.
#   openssl rand -hex 32
MW_RDV_OWNER_SECRET=change-me-to-a-long-random-secret

# Max NEW identifiers a single client IP may claim per hour (0 = unlimited).
# A host re-presenting an identifier it already owns is not charged, so a machine
# that reboots often is unaffected. Optional; default 20.
MW_RDV_MAX_NEW_PER_HOUR=20

# Browser connection attempts per client IP per minute (0 = unlimited). This is
# what bounds guessing identifiers, so treat it as a security control rather than
# hygiene. Optional; default 30.
MW_RDV_MAX_PEER_PER_MIN=30

# Concurrent browsers a single host will accept. Optional; default 4.
MW_RDV_MAX_SESSIONS=4

# ── TLS for the API (api.{MW_DOMAIN}) ────────────────────────────────────────
# Two options, user-supplied files take PRIORITY:
#
# Option A (default): leave MW_TLS_CERT / MW_TLS_KEY empty → Caddy obtains and
# auto-renews a Let's Encrypt certificate. MW_TLS_EMAIL is optional but
# recommended (expiry notices from the CA).
MW_TLS_EMAIL=

# Option B: bring your own cert. Put the files under ./certs (bind-mounted to
# /certs in the container) and point these at the in-container paths. When BOTH
# are set they override Let's Encrypt entirely.
MW_TLS_CERT=
MW_TLS_KEY=
# Example:
#   MW_TLS_CERT=/certs/fullchain.pem
#   MW_TLS_KEY=/certs/privkey.pem

# ── Analytics (Umami, served at https://stats.{MW_DOMAIN}) ───────────────────
# Both are SECRETS — generate long random values, e.g. openssl rand -hex 24.
#   MW_UMAMI_DB_PASSWORD  password for Umami's internal Postgres.
#   MW_UMAMI_SECRET       signs the Umami dashboard login sessions (APP_SECRET).
# First login to the dashboard is admin / umami — change the password immediately,
# create a website named "MoonlightWeb", then paste its ID into website/index.html.
MW_UMAMI_DB_PASSWORD=change-me-to-a-long-random-secret
MW_UMAMI_SECRET=change-me-to-a-long-random-secret

# ── Installed-version census (updates.{MW_DOMAIN}) ───────────────────────────
# MoonlightWeb 0.3.0+ runs its periodic update check against the relay served at
# https://updates.{MW_DOMAIN} instead of api.github.com. The relay mirrors the
# latest GitHub release (cached, so the whole fleet costs a handful of upstream
# requests per hour) and records each check in Umami, which is what makes
# "who is still on 0.2.x?" answerable when planning a migration.
#
# Set this to the ID of a SECOND Umami website (suggested name "MoonlightWeb
# clients", domain updates.{MW_DOMAIN}) so fleet data never mixes with the
# marketing site's stats. Leave it EMPTY to serve updates without counting
# anything — the relay works either way.
MW_UMAMI_TELEMETRY_WEBSITE_ID=

# Optional: seconds a fetched GitHub release stays authoritative (default 600).
#MW_UPDATE_CACHE_SECONDS=600

# ── Session census (metrics.{MW_DOMAIN}) ─────────────────────────────────────
# MoonlightWeb 0.3.0+ reports the SHAPE of a stream when one starts and how long
# it lasted when it ends: resolution, frame rate, codec, HDR, bitrate band,
# backend, transport, whether the viewer was on the LAN or the internet. No host
# name, no account, no application — see deploy/powerdns/mw-proxy/session.go for
# the exhaustive list and the sanitising rules.
#
# Set this to the ID of a THIRD Umami website (suggested name "MoonlightWeb
# sessions", domain metrics.{MW_DOMAIN}). Its own website on purpose: there,
# "views" means "sessions started" with nothing else mixed in. Leave it EMPTY
# and the endpoint still answers, counting nothing.
#
# This alone does NOT turn the census on: metrics.{MW_DOMAIN} is not published
# and has no site block, so nothing reaches /v1/session. See "Session census" in
# README.md for the two steps that publish it.
MW_UMAMI_SESSIONS_WEBSITE_ID=
