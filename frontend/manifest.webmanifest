{
    "name": "MoonlightWeb",
    "short_name": "MoonlightWeb",
    "description": "Stream your gaming PC to any browser",
    "start_url": "/",
    "scope": "/",
    "display": "fullscreen",
    "display_override": ["fullscreen", "standalone"],
    "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
    "orientation": "landscape",
    "background_color": "#05080b",
    "theme_color": "#05080b",
    "icons": [
        {
            "src": "assets/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "assets/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ]
}
