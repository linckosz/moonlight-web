#!/bin/bash
# ===========================================================================
#  MoonlightWeb — macOS .pkg postinstall (runs as root during the Install phase).
#
#  Mirrors what the Windows Inno installer does before the app's first run:
#    1. drop a provisioning.json in the console user's app-data dir so the server
#       brings Internet Access up on first launch (Provisioning::applyOnce — the
#       same file/contract as Windows),
#    2. install the per-user LaunchAgent (auto-start at login, keeps the tray),
#    3. launch the app once now so the in-app live checklist (SetupView /
#       provisioning.status.json) shows in the browser.
#
#  It installs NO streaming server. Since September 2026 the app captures and
#  encodes this Mac itself (ScreenCaptureKit → VideoToolbox, design §20), so
#  there is nothing to download, no `sunshine --creds` to run, and — the point
#  that matters most — no plaintext password written to this disk. Sunshine
#  remains fully supported as a HOST: a machine that already runs it is
#  discovered and paired from the hosts page like any other. The one permission
#  this cannot arrange is Screen Recording, which macOS grants only by hand:
#  the app asks for it itself on first launch, and the wizard says so.
#
#  User choices (Internet toggle and the exact consent text) are handed over by
#  the InstallerPlugin pane via /tmp/moonlightweb-provisioning.plist (written in
#  the user session; read here as root).
# ===========================================================================
set -u

# Filled in by build-pkg.sh for the edition being packaged: MoonlightWeb, or
# MoonlightWebDev beside it — its own bundle, LaunchAgent and app-data dir, so a
# pre-release never touches the production install.
APP_NAME="@MW_APP_NAME@"
AGENT_LABEL="@MW_AGENT_LABEL@"
APP="/Applications/$APP_NAME.app"
EXE="$APP/Contents/MacOS/$APP_NAME"
HANDOFF="/tmp/moonlightweb-provisioning" # `defaults` appends .plist
LOG="/tmp/moonlightweb-postinstall.log"
exec >>"$LOG" 2>&1
echo "== postinstall $(date) =="

# ── Console (GUI) user: scripts run as root, but the LaunchAgent, app-data dir
#    and the app launch must target the logged-in user's session. ────────────
CONSOLE_USER="$(/usr/bin/stat -f %Su /dev/console)"
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
    # No one logged in (e.g. `installer` CLI as root): fall back to $USER/$HOME.
    CONSOLE_USER="${USER:-root}"
fi
CONSOLE_UID="$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null || echo 0)"
CONSOLE_HOME="$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
[ -z "$CONSOLE_HOME" ] && CONSOLE_HOME="/Users/$CONSOLE_USER"
echo "console user=$CONSOLE_USER uid=$CONSOLE_UID home=$CONSOLE_HOME"

# ── Read the plugin hand-off (best-effort defaults; no jq/python on stock macOS).
read_val() { /usr/bin/defaults read "$HANDOFF" "$1" 2>/dev/null; }
# Absent key → the default, so a plain `installer` CLI run (no plugin pane, no
# hand-off) behaves as if the pane had been left alone: LAN only.
read_flag() { # <key> <default:true|false>
    case "$(read_val "$1")" in
        1|true) echo "true" ;;
        0|false) echo "false" ;;
        *) echo "$2" ;;
    esac
}
INTERNET="$(read_flag internet false)"
CONSENT="$(read_val consent)" # exact agreement text shown in the installer pane
echo "handoff: internet=$INTERNET"

# ── 1) provisioning.json, consumed and removed by the server on first run
#    (Provisioning::applyOnce). Written into the console user's Qt
#    AppDataLocation (~/Library/Application Support/MoonlightWeb/$APP_NAME),
#    owned by them.
#
#    No "sunshine" object any more: this installer installs no streaming server
#    and pairs no local host, so there is nothing to auto-pair. applyOnce reads a
#    missing object as auto_pair=false and marks the step skipped, so an older
#    server given this file behaves exactly as if Skip had been clicked — and no
#    plaintext credential is ever written to disk.
json_escape() { printf '%s' "$1" | /usr/bin/sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
APPDATA="$CONSOLE_HOME/Library/Application Support/MoonlightWeb/$APP_NAME"
/bin/mkdir -p "$APPDATA"
cat > "$APPDATA/provisioning.json" <<JSON
{
  "internet_access_authorized": $INTERNET,
  "consent_message": "$(json_escape "$CONSENT")"
}
JSON
/usr/sbin/chown -R "$CONSOLE_USER" "$CONSOLE_HOME/Library/Application Support/MoonlightWeb"
echo "wrote $APPDATA/provisioning.json (internet=$INTERNET)"

# ── 2) LaunchAgent: auto-start at login (mirrors Autostart::installLoginItem).
#    RunAtLoad + KeepAlive/SuccessfulExit=false → relaunch on crash only, never
#    after a clean quit. NOT bootstrapped here (we launch once below instead);
#    launchd loads it at the next login.
AGENTS="$CONSOLE_HOME/Library/LaunchAgents"
LOGDIR="$APPDATA/logs"
/bin/mkdir -p "$AGENTS" "$LOGDIR"
cat > "$AGENTS/$AGENT_LABEL.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$AGENT_LABEL</string>
    <key>ProgramArguments</key>
    <array><string>$EXE</string><string>--autostart</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key>
    <dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>ProcessType</key><string>Interactive</string>
    <key>StandardOutPath</key><string>$LOGDIR/agent.log</string>
    <key>StandardErrorPath</key><string>$LOGDIR/agent.log</string>
</dict>
</plist>
PLIST
/usr/sbin/chown "$CONSOLE_USER" "$AGENTS/$AGENT_LABEL.plist"
echo "wrote LaunchAgent"

# ── 2a) Hand the app-data tree to the user. This script runs as root, so every
#    dir/file created above (provisioning.json, logs/) is root-owned; the app
#    runs in the user session and would silently fail to write settings.json,
#    sessions.json and logs/moonlightweb.log (QFile::open reports nothing).
/usr/sbin/chown -R "$CONSOLE_USER" "$CONSOLE_HOME/Library/Application Support/MoonlightWeb" \
    || echo "WARN: chown app-data failed"
echo "chowned app-data to $CONSOLE_USER"

# ── 2b) Allow the app through the macOS application firewall. It is per-app
#    (not per-port), so this covers every port the server ever binds — 443, a
#    per-instance parity port (e.g. when another device already forwards 443 on
#    the router), or a startup fallback — without a further prompt. Best-effort:
#    a no-op when the firewall is off; harmless when already allowed.
SOCKETFW="/usr/libexec/ApplicationFirewall/socketfilterfw"
if [ -x "$SOCKETFW" ] && [ -x "$EXE" ]; then
    "$SOCKETFW" --add "$EXE" >/dev/null 2>&1 || echo "WARN: firewall --add failed"
    "$SOCKETFW" --unblockapp "$EXE" >/dev/null 2>&1 || echo "WARN: firewall --unblockapp failed"
    echo "firewall: allowed $EXE"
fi

# ── 3) Launch the app once in the user session (no --autostart → it opens the
#    browser so the live setup checklist shows while provisioning runs). This is
#    also what makes macOS put its Screen Recording question in front of the
#    user while they are still sitting at this Mac: the native engine's probe
#    asks for the permission on startup, and TCC only shows that prompt for a
#    running program. Nothing here can grant it on their behalf.
if [ "$CONSOLE_UID" != "0" ]; then
    /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" \
        /usr/bin/open -a "$APP" || echo "WARN: could not launch the app"
fi

# ── Cleanup: the hand-off is short-lived by design; it no longer carries any
#    credential, and there is nothing to be gained by leaving it behind.
/bin/rm -f "$HANDOFF.plist"
echo "== postinstall done =="
exit 0
