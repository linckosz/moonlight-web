diff --git a/src/socket.h b/src/socket.h
index 93899f5..d390827 100644
--- a/src/socket.h
+++ b/src/socket.h
@@ -109,6 +109,42 @@ typedef int sockopt_t;
 
 #endif // _WIN32
 
+// MoonlightWeb patch: no socket or pipe of libjuice passes to a process the program starts. A child that
+// held one would keep its port bound after the agent closed it, for as long as the child runs.
+#ifdef _WIN32
+#ifndef WSA_FLAG_NO_HANDLE_INHERIT
+#define WSA_FLAG_NO_HANDLE_INHERIT 0x80
+#endif
+// The handle made not inheritable (a socket made by accept(), say)
+static inline void socket_set_private(socket_t sock) {
+	SetHandleInformation((HANDLE)sock, HANDLE_FLAG_INHERIT, 0);
+}
+// socket(), with a handle no child inherits (socket() also asks for overlapped I/O)
+static inline socket_t socket_private(int domain, int type, int protocol) {
+	return WSASocketW(domain, type, protocol, NULL, 0,
+	                  WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT);
+}
+#else
+// The descriptor closed at exec
+static inline void socket_set_private(int fd) {
+	int flags = fcntl(fd, F_GETFD);
+	if (flags >= 0)
+		fcntl(fd, F_SETFD, flags | FD_CLOEXEC);
+}
+// socket(), with a descriptor closed at exec: at its creation where the system can, right after
+// it elsewhere
+static inline socket_t socket_private(int domain, int type, int protocol) {
+#ifdef SOCK_CLOEXEC
+	return socket(domain, type | SOCK_CLOEXEC, protocol);
+#else
+	socket_t sock = socket(domain, type, protocol);
+	if (sock != INVALID_SOCKET)
+		socket_set_private(sock);
+	return sock;
+#endif
+}
+#endif
+
