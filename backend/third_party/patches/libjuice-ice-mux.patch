+// MoonlightWeb patch: the class of one datagram (its Differentiated Services byte) on a shared
+// socket. Agents of several processes send on such a socket: its own class (udp_set_diffserv())
+// would be whichever of them set it last. So the socket's is never set, and a datagram that has a
+// class carries it itself, as ancillary data. Windows documents that for ECN only: where the
+// system refuses it, the datagrams of a shared socket leave unmarked.
+
+// The family a socket was made with, 0 when the system will not say. A shared socket's is
+// read once, when the sockets are set: a bound socket keeps it, and a datagram that carries
+// its class goes by it.
+static int socket_family(socket_t sock) {
+	addr_record_t name;
+	name.len = sizeof(name.addr);
+	if (getsockname(sock, (struct sockaddr *)&name.addr, &name.len) != 0)
+		return 0;
+	return name.addr.ss_family;
+}
+
+// Whether a send error says "no class for one datagram here", and nothing else. Any other is
+// the datagram's own, as for a plain send (the buffer is full, it is too large, no route).
+bool conn_poll_class_refused(int err) {
+#ifdef _WIN32
+	return err == WSAEINVAL || err == WSAENOPROTOOPT || err == WSAEOPNOTSUPP;
+#else
+	return err == EINVAL || err == ENOPROTOOPT || err == EOPNOTSUPP;
+#endif
+}
+
+static int sendto_with_class(socket_t sock, int family, const char *data, size_t size,
+                             const addr_record_t *dst, int ds) {
+	// Which class it is, IPv4's or IPv6's, is said by the address the datagram really goes to:
+	// an IPv4 peer of an IPv6 socket is reached IPv4-mapped (as in udp_sendto()), and is IPv4.
+	addr_record_t tmp = *dst;
+	if (family == 0)
+		family = socket_family(sock);
+	bool inet6_sock = family == AF_INET6;
+	bool tos = tmp.addr.ss_family == AF_INET;
+	if (tmp.addr.ss_family == AF_INET6)
+		tos = IN6_IS_ADDR_V4MAPPED(&((const struct sockaddr_in6 *)&tmp.addr)->sin6_addr);
+#ifndef __linux__
+	if (inet6_sock)
+		addr_map_inet6_v4mapped(&tmp.addr, &tmp.len);
+#endif
+#ifdef __APPLE__
+	// macOS refuses IP_TOS on a dual-stack socket: an IPv4-mapped peer takes the IPv6 class
+	if (inet6_sock)
+		tos = false;
+#endif
+	(void)inet6_sock;
+	int value = ds & 0xFF;
+
+#ifdef _WIN32
+	union {
+		WSACMSGHDR header; // for the alignment
+		char space[WSA_CMSG_SPACE(sizeof(int))];
+	} control;
+	memset(&control, 0, sizeof(control));
+	WSABUF buf;
+	buf.buf = (char *)data;
+	buf.len = (ULONG)size;
+	WSAMSG msg;
