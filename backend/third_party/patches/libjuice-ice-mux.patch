+// MoonlightWeb patch: an agent on UDP sockets it shares with agents of other processes, so that
+// all of them are reached on the same ports. One process holds the sockets and is the only one
+// to read them. It hands each datagram to the agent it is for on that agent's feed socket,
+// behind a header that names where the datagram came from and which socket it came in on. The
+// agent sends on its own handles of the shared sockets, straight to the peer, and never reads
+// them. Each (peer address, socket) is a candidate pair of its own, checked and nominated as
+// any other; for one peer address the earlier socket of the list is preferred.
+//
+// Poll mode only, before juice_gather_candidates(). The agent borrows every handle: it closes
+// none, and all must stay valid until juice_destroy() returns. The sockets must be non-blocking
+// (the agent sets the feed so itself), and the feed should be connected to the one address the
+// datagrams are handed over from, so that nothing else can put a datagram in.
+#define JUICE_SHARED_SOCKETS_MAX 4
+
+typedef struct juice_shared_sockets {
+	uintptr_t feed;                           // SOCKET or file descriptor, datagram
+	uintptr_t send[JUICE_SHARED_SOCKETS_MAX]; // bound UDP sockets, the preferred one first
+	int send_count;
+	// TCP connections to these ports are accepted elsewhere in this process and given with
+	// juice_tcp_passive_offer(): the agent then offers passive TCP candidates while it checks
+	bool tcp;
+} juice_shared_sockets_t;
+
+JUICE_EXPORT int juice_set_shared_sockets(juice_agent_t *agent,
+                                          const juice_shared_sockets_t *shared);
+
+// A TCP connection accepted on a shared port, with the first RFC 4571 frame read from it (its two
+// bytes of length left out). The agent must hold shared sockets with `tcp` set and still be
+// checking. The frame passes the gate of the agent's own listener and nothing else: only an
+// authenticated Binding request makes the connection the agent's. On success the socket is the
+// agent's, which closes it when it refuses it or is done with it; on an error (not such a
+// connection, the checks over, too many offered at once) it stays the caller's, as it was given.
+// Its source is the one the socket itself names. Any thread may call it.
+JUICE_EXPORT int juice_tcp_passive_offer(juice_agent_t *agent, uintptr_t socket, const char *frame,
+                                         size_t size);
+
+// The header before each datagram on a feed socket, JUICE_FEED_HEADER_SIZE bytes:
+//   0  version, JUICE_FEED_VERSION
+//   1  index of the shared socket the datagram came in on
+//   2  4 or 6, the family of the source address
+//   3  zero
+//   4  source port, in network byte order
+//   6  zero
+//   8  IPv6 scope of the source address, little-endian (zero for IPv4)
+//  12  source address: 4 bytes then 12 of zero, or 16 bytes
+//  28  a timestamp of the sender's choosing, little-endian (zero for none)
+// Writes it at `buffer`; returns its size, or -1 on a bad argument.
+#define JUICE_FEED_VERSION 1
+#define JUICE_FEED_HEADER_SIZE 36
+
+JUICE_EXPORT int juice_feed_write_header(void *buffer, size_t size, int ip_version,
+                                         const void *address, uint16_t port, uint32_t scope_id,
+                                         int via, uint64_t timestamp);
+
+// Called from the connections thread with the timestamp of each datagram a feed delivers, to
+// measure what the handover costs. Set it before the first agent gathers; NULL takes it out.
+typedef void (*juice_cb_feed_timestamp_t)(uint64_t timestamp);
+
+JUICE_EXPORT void juice_set_feed_timestamp_handler(juice_cb_feed_timestamp_t cb);
+
 // ICE server
 
