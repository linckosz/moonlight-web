+int agent_set_shared_sockets(juice_agent_t *agent, const juice_shared_sockets_t *shared) {
+	if (agent->conn_impl) {
+		JLOG_WARN("Unable to set shared sockets, candidates gathering already started");
+		return JUICE_ERR_FAILED;
+	}
+	// Only the poll mode reads a feed
+	if (agent->config.concurrency_mode != JUICE_CONCURRENCY_MODE_POLL ||
+	    shared->send_count < 1 || shared->send_count > JUICE_SHARED_SOCKETS_MAX) {
+		JLOG_ERROR("Invalid shared sockets");
+		return JUICE_ERR_INVALID;
+	}
+
+	agent->shared = *shared;
+	return JUICE_ERR_SUCCESS;
+}
