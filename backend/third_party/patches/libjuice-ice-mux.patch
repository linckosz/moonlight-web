+int agent_tcp_passive_offer(juice_agent_t *agent, uintptr_t sock, const char *frame, size_t size) {
+	// Only the poll mode has the waiting list a connection is put in
+	if (agent->config.concurrency_mode != JUICE_CONCURRENCY_MODE_POLL || !agent->conn_impl)
+		return JUICE_ERR_FAILED;
+
+	return conn_poll_tcp_offer(agent, (socket_t)sock, frame, size);
+}
