diff --git a/miniupnpc/src/miniupnpc_socketdef.h b/miniupnpc/src/miniupnpc_socketdef.h
index 5986e58..4fea423 100644
--- a/miniupnpc/src/miniupnpc_socketdef.h
+++ b/miniupnpc/src/miniupnpc_socketdef.h
@@ -41,4 +41,36 @@
 #define PRINT_SOCKET_ERROR(x) perror(x)
 #endif
 
+/* MoonlightWeb patch: no socket of miniupnpc passes to a process the program starts. A child
+ * that held one would keep it for as long as the child runs. */
+#ifdef _WIN32
+#include <winsock2.h>
+#include <windows.h>
+#ifndef WSA_FLAG_NO_HANDLE_INHERIT
+#define WSA_FLAG_NO_HANDLE_INHERIT 0x80
+#endif
+/* socket(), with a handle no child inherits (socket() also asks for overlapped I/O) */
+static __inline SOCKET miniupnpc_socket(int domain, int type, int protocol)
+{
+	return WSASocketW(domain, type, protocol, NULL, 0,
+	                  WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT);
+}
+#else
+#include <sys/socket.h>
+#include <fcntl.h>
+#ifdef SOCK_CLOEXEC
+#define miniupnpc_socket(domain, type, protocol) \
+	socket((domain), (type) | SOCK_CLOEXEC, (protocol))
+#else
+/* socket(), its descriptor closed at exec right after */
+static inline int miniupnpc_socket(int domain, int type, int protocol)
+{
+	int s = socket(domain, type, protocol);
+	if(s >= 0)
+		fcntl(s, F_SETFD, FD_CLOEXEC);
+	return s;
+}
+#endif
+#endif
+
 #endif /* MINIUPNPC_SOCKETDEF_H_INCLUDED */
