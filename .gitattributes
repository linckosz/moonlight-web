# Vendored / third-party code — excluded from GitHub language stats and
# collapsed in diffs so it doesn't drown the project's own sources.

# Prebuilt OpenSSL headers + import libs (committed Windows dependency).
backend/libs/** linguist-vendored

# Third-party C/C++ sources pulled in-tree (submodules + qmdnsengine copy).
backend/third_party/** linguist-vendored

# Minified / bundled browser vendor code.
frontend/js/vendor/** linguist-vendored

# Generated Qt MOC output should never be diffed if it slips in.
*.moc linguist-generated

# Line endings for build scripts: shell must stay LF (runs on Linux/macOS),
# batch stays CRLF, regardless of the checkout platform.
*.sh  text eol=lf
*.bat text eol=crlf

# Container build files must stay LF too. A CRLF .dockerignore is the sharp
# edge: its patterns are matched verbatim, so `backend\r` excludes nothing and
# the allowlist silently ships the whole working tree to the daemon.
Dockerfile     text eol=lf
.dockerignore  text eol=lf

# JS must stay LF on every platform: .prettierrc pins `endOfLine: "lf"`, so a
# CRLF checkout (core.autocrlf=true on Windows) makes `npm run format` fail on
# every file while CI on Linux stays green.
*.js  text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.ts  text eol=lf
