struct VSOut {
    @builtin(position) pos : vec4f,
    @location(0) uv : vec2f,
};

@vertex
fn vs(@builtin(vertex_index) vid : u32) -> VSOut {
    var out : VSOut;
    let uv = vec2f(f32((vid << 1u) & 2u), f32(vid & 2u));
    out.uv = uv;
    out.pos = vec4f(uv * vec2f(2.0, -2.0) + vec2f(-1.0, 1.0), 0.0, 1.0);
    return out;
}

struct U {
    texel : vec2f,
    scale : vec2f,
    dims : vec2f,
    across : vec2f,
    kc : f32,
    ft : f32,
    kg : f32,
    kwc : f32,
    zc : vec2f,
    zr : vec2f,
    zring : f32,
    zft : f32,
    zkg : f32,
    gaze : f32,
    kl : f32,
    zref : f32,
    pad1 : f32,
    pad2 : f32,
};

@group(0) @binding(0) var samp : sampler;
@group(0) @binding(1) var tex : texture_2d<f32>;
@group(0) @binding(2) var<uniform> u : U;

fn S(uv : vec2f) -> vec3f {
    return textureSampleLevel(tex, samp, uv, 0.0).rgb;
}

alias hf = f32;
alias h3 = vec3<f32>;

override SHOW : u32 = 0u;
override CHROMA444 : u32 = 0u;
override GAZE : u32 = 0u;
override R_DOWN : f32 = 1.0;
override LINEAR_LIGHT : u32 = 1u;

const LUMA : vec3f = vec3f(0.25, 0.625, 0.125);

// The sRGB transfer, both ways, for LINEAR_LIGHT 2 (the encode alone for 3);
// past 1.0 (HDR) the same formula continues, as the renderer's HDR pass 0
// encodes it.
fn srgbToLin(c : vec3f) -> vec3f {
    let lo = c / 12.92;
    let hi = pow((max(c, vec3f(0.0)) + 0.055) / 1.055, vec3f(2.4));
    return select(hi, lo, c <= vec3f(0.04045));
}

fn linToSrgb(c : vec3f) -> vec3f {
    let lo = c * 12.92;
    let hi = 1.055 * pow(max(c, vec3f(0.0)), vec3f(1.0 / 2.4)) - 0.055;
    return select(hi, lo, c <= vec3f(0.0031308));
}

fn dec(c : vec3f) -> vec3f {
    if (LINEAR_LIGHT == 1u) {
        return c * c;
    }
    if (LINEAR_LIGHT == 2u) {
        return srgbToLin(c);
    }
    return c;
}

fn enc(c : vec3f) -> vec3f {
    if (LINEAR_LIGHT == 1u) {
        return sqrt(max(c, vec3f(0.0)));
    }
    if (LINEAR_LIGHT >= 2u) {
        return linToSrgb(c);
    }
    return c;
}

@fragment
fn fs(in : VSOut) -> @location(0) vec4f {
    let uv = in.uv;
    // The pixel's footprint in the input, 1 / scale texels per axis, spanned
    // by the grid (R_DOWN 1); 4×4 samples at its 4×4 centres.
    let span = u.texel / u.scale * R_DOWN;
    var acc = vec3f(0.0);
    acc += dec(S(uv + vec2f(-0.375, -0.375) * span));
    acc += dec(S(uv + vec2f(-0.125, -0.375) * span));
    acc += dec(S(uv + vec2f(0.125, -0.375) * span));
    acc += dec(S(uv + vec2f(0.375, -0.375) * span));
    acc += dec(S(uv + vec2f(-0.375, -0.125) * span));
    acc += dec(S(uv + vec2f(-0.125, -0.125) * span));
    acc += dec(S(uv + vec2f(0.125, -0.125) * span));
    acc += dec(S(uv + vec2f(0.375, -0.125) * span));
    acc += dec(S(uv + vec2f(-0.375, 0.125) * span));
    acc += dec(S(uv + vec2f(-0.125, 0.125) * span));
    acc += dec(S(uv + vec2f(0.125, 0.125) * span));
    acc += dec(S(uv + vec2f(0.375, 0.125) * span));
    acc += dec(S(uv + vec2f(-0.375, 0.375) * span));
    acc += dec(S(uv + vec2f(-0.125, 0.375) * span));
    acc += dec(S(uv + vec2f(0.125, 0.375) * span));
    acc += dec(S(uv + vec2f(0.375, 0.375) * span));
    return vec4f(enc(acc * 0.0625), 1.0);
}
